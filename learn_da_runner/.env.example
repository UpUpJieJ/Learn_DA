# Runner 服务配置（复制为 .env 后修改）

# Backend 与 Runner 共用的内部认证密钥；生产环境至少 32 字符
RUNNER_TOKEN=

RUNNER_PORT=8080

# 执行后端：
#   docker —— 生产唯一选择，代码在一次性受限容器里执行
#   local  —— 仅本地开发用（宿主解释器执行，无网络隔离、无只读文件系统）
RUNNER_PROVIDER=docker
RUNNER_ENV=development

# 仅 RUNNER_PROVIDER=local 时生效：必须显式开启，且 RUNNER_ENV/APP_ENV 不能是 production
RUNNER_ALLOW_LOCAL_EXECUTION=0
# 空 = 用运行 Runner 的解释器；本地建议指向已安装 polars/duckdb/pyarrow 的 venv
RUNNER_LOCAL_PYTHON=

# 沙箱限制（docker provider 生效；local provider 只沿用超时与输出上限）
RUNNER_TIMEOUT_SECONDS=5
RUNNER_MEMORY_LIMIT_MB=256
RUNNER_CPU_QUOTA=50000
RUNNER_PIDS_LIMIT=64
RUNNER_TMPFS_SIZE_MB=64
RUNNER_MAX_OUTPUT_BYTES=65536
# 会话执行（重放式多 cell）：整个前缀在一个进程里跑完，预算比单段代码大
RUNNER_SESSION_TIMEOUT_SECONDS=20
# 单次会话请求里所有数据集解码后的总字节上限
RUNNER_SESSION_MAX_DATASET_BYTES=2000000
RUNNER_DOCKER_IMAGE=polars-duckdb-sandbox:latest
# 空 = 本地 Docker socket
RUNNER_DOCKER_HOST=