# Copy to deploy/runner.env on the dedicated Runner server. Do not commit it.
# It must use exactly the same RUNNER_TOKEN as deploy/app.env.
RUNNER_TOKEN=replace-with-the-shared-64-character-token
RUNNER_PORT=8080
# Bind only to a private address reachable from the application server.
RUNNER_BIND_ADDRESS=10.0.0.20
RUNNER_DOCKER_IMAGE=polars-duckdb-sandbox:latest

# On the Runner server run: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=999

RUNNER_TIMEOUT_SECONDS=5
RUNNER_MEMORY_LIMIT_MB=256
RUNNER_CPU_QUOTA=50000
RUNNER_PIDS_LIMIT=64
RUNNER_TMPFS_SIZE_MB=64
RUNNER_MAX_OUTPUT_BYTES=65536

APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
