# Copy to deploy/app.env on the application server. Do not commit the copy.
PUBLIC_ORIGIN=https://learn.example.com
HTTP_PORT=80

# Use a private address or private DNS name of the dedicated Runner server.
RUNNER_URL=http://10.0.0.20:8080
# Generate with: openssl rand -hex 32
RUNNER_TOKEN=replace-with-the-shared-64-character-token
SESSION_SECRET=replace-with-a-different-64-character-session-secret
RUNNER_TIMEOUT_SECONDS=7

# 主 LLM 配置；未设置时使用下方 FALLBACK_LLM_* 兜底
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# 兜底 LLM 配置（仅在对应 LLM_* 未设置时生效）
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=gpt-4o-mini

# A single Backend replica may use SQLite. Use MySQL for multi-replica production.
DATABASE_URL=sqlite+aiosqlite:///./data/learn_da.db

TRUSTED_PROXY_IPS=

APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
